generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PrintJob {
  id                String   @id @default(cuid())
  customerName      String
  productName       String
  quantity          Int      @default(1)
  filamentUsedGrams Float    @default(0)
  printTimeMinutes  Int      @default(0)
  filamentCost      Float    @default(0)
  electricityCost   Float    @default(0)
  otherCost         Float    @default(0)
  totalCost         Float    @default(0)
  sellingPrice      Float    @default(0)
  profit            Float    @default(0)
  status            String   @default("PENDING") // PENDING | PRINTING | COMPLETED | CANCELLED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
